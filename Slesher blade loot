local splashClosed = false

local function closeSplash()
    if splashClosed then
        return
    end

    splashClosed = true

    TweenService:Create(
        blur,
        TweenInfo.new(0.3),
        {Size = 0}
    ):Play()

    for _, obj in ipairs(splashBG:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            TweenService:Create(
                obj,
                TweenInfo.new(0.25),
                {TextTransparency = 1}
            ):Play()

        elseif obj:IsA("Frame") then
            TweenService:Create(
                obj,
                TweenInfo.new(0.25),
                {BackgroundTransparency = 1}
            ):Play()
        end
    end

    task.wait(0.3)

    if splashGui.Parent then
        splashGui:Destroy()
    end

    if blur.Parent then
        blur:Destroy()
    end
end

skip.Activated:Connect(closeSplash)

